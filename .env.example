# =========================
# API 서버
# =========================
# 로컬 iOS 시뮬레이터/웹은 127.0.0.1을 사용할 수 있습니다.
# 실기기 테스트에서는 현재 Mac의 LAN IP로 바꿔야 합니다.
# 예: EXPO_PUBLIC_API_BASE_URL=http://172.30.1.48:3000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# true면 개발 중 API 요청/응답 로그를 출력합니다.
EXPO_PUBLIC_API_DEBUG=true

# =========================
# AdMob 앱 ID
# =========================
# 네이티브 빌드 시 필요한 AdMob App ID입니다.
# 서버에서 내려주는 Rewarded Ad Unit ID와 다른 값입니다.
# production EAS 빌드에서는 실제 값을 반드시 제공해야 합니다.
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

# =========================
# AdMob 테스트 모드
# =========================
# true면 서버가 실제 광고 단위 ID를 내려줘도 Google 공식 테스트 Rewarded ID로 광고를 띄웁니다.
# 개발/내부 QA에서는 true, 스토어 제출/운영 빌드에서는 false로 설정합니다.
EXPO_PUBLIC_ADMOB_USE_TEST_ADS=true

# =========================
# 프리미엄 앱내 구입
# =========================
# App Store Connect에 프리미엄 IAP 상품을 연결한 제출 빌드에서는 true여야 합니다.
# false로 두면 /premium 화면과 프리미엄 메뉴가 숨겨져 App Review에서 상품을 찾지 못할 수 있습니다.
EXPO_PUBLIC_PREMIUM_IAP_ENABLED=true
